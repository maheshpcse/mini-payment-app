# Public build-time values only. Anything prefixed VITE_ is embedded in the browser bundle,
# so never put secrets, API keys or tokens here.

# Base URL of mini-payment-server, including the version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Label shown in the utility dock: local | development | staging | production
VITE_APP_ENV=local
# Show the demo sign-in shortcuts on the login page (accounts are seeded by the API's migrations)
VITE_DEMO_LOGIN=true
