# Reference for GitHub Pages builds. In CI these come from repository variables, not this file.
# Everything here is embedded in the public bundle: never put secrets, keys or tokens here.
# Local production build: copy to .env.pages.local, then `npm run build:pages`.

# Railway API URL including the version prefix (HTTPS, no trailing slash).
VITE_API_BASE_URL=https://YOUR-SERVICE.up.railway.app/api/v1
VITE_APP_ENV=production
# Repository sub-path on https://<user>.github.io/<repository>/ ; leave empty for a custom domain.
PAGES_BASE_PATH=/mini-payment-app/
